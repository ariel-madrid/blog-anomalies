# Copia este archivo a .env y completa con tus valores reales.
# NO subas el .env real al repositorio (contiene secretos).

# Proyecto Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Credenciales del panel /admin (validación en el cliente)
VITE_ADMIN_USER=tu_usuario
VITE_ADMIN_PASS=tu_contraseña_segura
